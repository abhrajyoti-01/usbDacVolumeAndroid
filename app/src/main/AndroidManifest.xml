<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Avoids the audio capture warning in the USB permission dialog. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Lets the user exempt the app from battery optimization so the system
         does not kill it (which would skip automatic volume apply). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="true" />

    <application
        android:name=".UsbDacApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LibusbAndroidTest">
        <activity
            android:name="com.example.libusbAndroidTest.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Invisible handler for USB device attach events. The system starts
            it when a DAC is plugged in; it never shows a window and finishes
            immediately. It also makes the app eligible for the "always use"
            USB permission checkbox. The component is disabled by default and
            only enabled while automatic mode is selected, so with automatic
            mode off plugging a DAC launches nothing at all.
        -->
        <activity
            android:name="com.example.libusbAndroidTest.UsbAttachActivity"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@style/Theme.USBTransparent"
            android:taskAffinity="">
            <!--
                The system starts this activity for USB_DEVICE_ATTACHED, so it
                must be exported. Spoofed intents from other apps are harmless:
                the handler validates the device against the live USB device
                list and requires the system-granted USB permission.
            -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>

            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <!-- Receives the USB permission dialog result (explicit broadcast). -->
        <receiver
            android:name="com.example.libusbAndroidTest.UsbPermissionReceiver"
            android:exported="false" />

        <!-- Tracks real unplug events (protected system broadcast). -->
        <receiver
            android:name="com.example.libusbAndroidTest.UsbDetachReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_DETACHED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
